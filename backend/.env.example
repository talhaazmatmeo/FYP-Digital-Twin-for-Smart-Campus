# Copy to .env and adjust as needed
# (Do not commit your real .env with secrets)

MQTT_BROKER=localhost
MQTT_PORT=1883
# Comma-separated list of topics. If unset, backend defaults to campus/room1/sensors
MQTT_TOPICS=campus/room1/sensors

# Flask secret key (set a strong random value in your real .env)
SECRET_KEY=change-me

# Optional: override the default SQLite path (defaults to backend/campus_twin.db)
# SQLITE_PATH=backend/campus_twin.db
